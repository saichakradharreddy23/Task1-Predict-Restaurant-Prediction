{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://task1-predict-restaurant-prediction.onrender.com/api/:path*"
    },
    {
      "source": "/outputs/:path*",
      "destination": "https://task1-predict-restaurant-prediction.onrender.com/outputs/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}
